generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActorType {
  client
  human
}

enum JobStatus {
  draft
  funded
  in_progress
  completed
  disputed
}

enum MilestoneStatus {
  pending
  awaiting_submission
  under_verification
  needs_revision
  approved
  released
  disputed
}

enum VerificationVerdict {
  approved
  needs_revision
  rejected
  uncertain
}

enum NanopaymentEventKind {
  buyer_native_funding
  buyer_usdc_funding
  gateway_deposit
  verification_preview
}

model ActorProfile {
  id              String       @id
  name            String
  walletAddress   String       @unique
  type            ActorType
  categories      String[]
  completedCount  Int
  passRate        Float
  onTimeRate      Float
  disputeRate     Float
  averageRating   Float
  totalEarnedUsd  Float
  clientJobs      Job[]        @relation("ClientJobs")
  workerJobs      Job[]        @relation("WorkerJobs")
  submissions     Submission[] @relation("ActorSubmissions")
}

model Job {
  id             String       @id
  title          String
  description    String
  status         JobStatus
  totalAmountUsd Float
  createdAt      DateTime     @default(now())
  fundedAt       DateTime?
  arcJobId       String?
  clientId       String
  workerId       String
  categoryTags   String[]
  client         ActorProfile @relation("ClientJobs", fields: [clientId], references: [id])
  worker         ActorProfile @relation("WorkerJobs", fields: [workerId], references: [id])
  milestones     Milestone[]
  submissions    Submission[]
  verifications  VerificationResult[]
  nanopayments   NanopaymentEvent[]
}

model Milestone {
  id                 String               @id
  jobId              String
  title              String
  description        String
  amountUsd          Float
  dueDate            DateTime
  proofRequirements  String[]
  acceptanceCriteria String[]
  status             MilestoneStatus
  sequence           Int
  releasedAt         DateTime?
  arcTxHash          String?
  job                Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  submissions        Submission[]
  verifications      VerificationResult[]
  nanopayments       NanopaymentEvent[]

  @@index([jobId, sequence])
}

model Submission {
  id          String               @id
  jobId       String
  milestoneId String
  submitterId String
  summary     String
  proofLinks  String[]
  notes       String?
  submittedAt DateTime             @default(now())
  job         Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  milestone   Milestone            @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  submitter   ActorProfile         @relation("ActorSubmissions", fields: [submitterId], references: [id])
  verification VerificationResult?
  nanopayments NanopaymentEvent[]

  @@index([jobId, milestoneId])
}

model NanopaymentEvent {
  id             String               @id
  kind           NanopaymentEventKind
  jobId          String?
  milestoneId    String?
  submissionId   String?
  payerAddress   String?
  sellerAddress  String?
  network        String?
  assetAddress   String?
  amount         String?
  transactionRef String?
  metadata       Json?
  createdAt      DateTime             @default(now())
  job            Job?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)
  milestone      Milestone?           @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  submission     Submission?          @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
  @@index([milestoneId, createdAt])
  @@index([submissionId, createdAt])
}

model VerificationResult {
  id           String               @id
  jobId        String
  milestoneId  String
  submissionId String               @unique
  verdict      VerificationVerdict
  confidence   Float
  source       String               @default("mock")
  externalRef  String?
  rawResult    Json?
  reasons      String[]
  createdAt    DateTime             @default(now())
  job          Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  milestone    Milestone            @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  submission   Submission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([jobId, milestoneId])
}

model WalletChallenge {
  id         String   @id
  address    String
  chainId    Int
  nonce      String   @unique
  message    String
  issuedAt   DateTime @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([address, nonce])
}
